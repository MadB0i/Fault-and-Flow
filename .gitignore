# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
*.local
build/
tsconfig.tsbuildinfo

# Test output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.nightly/

# Raw data — large, reproducible, never committed. See docs/DATA.md
data/raw/*
!data/raw/.gitkeep

# Processed data: only small, committed files are tracked. See docs/DATA.md
data/processed/*
!data/processed/.gitkeep
# Anything in data/processed over 5 MB must not be committed (see AGENTS.md)
data/processed/**/*
!data/processed/.gitkeep
!data/processed/README.md
# Terrain artefacts ARE committed: the pipeline's output is the product's data,
# and a rebuild needs network access to a third party. Tests assert the per-file
# 5 MB ceiling and the 9 MB total budget, so these exceptions cannot quietly
# become a way past AGENTS.md §5.
!data/processed/manifest.json
!data/processed/*-overview.png
!data/processed/*-overview.json
!data/processed/majuli.png
!data/processed/majuli.json
!data/processed/sadiya-dibrugarh.png
!data/processed/sadiya-dibrugarh.json

# Preview hillshades and the window cache are build by-products. Never committed.
data/raw/previews/
data/raw/cache/

# Environment
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / TS
.vite/
*.tsbuildinfo

# Editors' caches
.cache/
.parcel-cache/
.eslintcache